# Copy to .env (local dev) and set the same values as build env vars on your host.
# These are public values (the anon/publishable key is safe in the browser; RLS protects data).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
